// وسيط Google Sheets — اربطه بالملف الأصلي من Extensions > Apps Script.
const SPREADSHEET_ID = '1DE2Ko35v9iotJw3aSk0NYSjBKmPQv2IwONQs0BYuTN8';
const SHEET_NAMES = ['الاشتراكات','الاشتراكات الخاصة'];
function response_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
function validSheet_(name){if(!SHEET_NAMES.includes(name))throw Error('نوع الاشتراك غير مسموح');let sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(name);if(!sh)throw Error('الورقة غير موجودة: '+name);return sh}
function doGet(e){try{if((e.parameter.action||'list')!=='list')throw Error('عملية غير مدعومة');let records=[];for(let name of SHEET_NAMES){let sh=validSheet_(name),last=sh.getLastRow();if(last<2)continue;let vals=sh.getRange(2,1,last-1,9).getValues();vals.forEach((v,i)=>{if(!String(v[0]).trim())return;let date=v[4] instanceof Date?Utilities.formatDate(v[4],Session.getScriptTimeZone(),'yyyy-MM-dd'):String(v[4]||'');records.push({sheet:name,row:i+2,name:String(v[0]||''),phone:String(v[1]||''),transport:String(v[2]||''),course:String(v[3]||''),date:date,cost:Number(v[5])||0,pay1:Number(v[6])||0,pay2:Number(v[7])||0})})}return response_({ok:true,records})}catch(err){return response_({ok:false,error:String(err.message)})}}
function doPost(e){let lock=LockService.getScriptLock();try{lock.waitLock(20000);let p=JSON.parse(e.postData.contents);if(p.action!=='save')throw Error('عملية غير مدعومة');let sh=validSheet_(p.sheet);let name=String(p.name||'').trim();if(!name)throw Error('الاسم مطلوب');let nums=['cost','pay1','pay2'].map(k=>Number(p[k]||0));if(nums.some(n=>!Number.isFinite(n)||n<0))throw Error('مبالغ غير صالحة');let row=Number(p.row)||0;if(row&&(row<2||row>sh.getLastRow()))throw Error('رقم الصف غير صحيح');if(!row)row=sh.getLastRow()+1;let [cost,pay1,pay2]=nums;let values=[[name,String(p.phone||''),String(p.transport||'لا'),String(p.course||''),String(p.date||''),cost,pay1,pay2,cost-pay1-pay2]];sh.getRange(row,1,1,9).setValues(values);return response_({ok:true,row})}catch(err){return response_({ok:false,error:String(err.message)})}finally{if(lock.hasLock())lock.releaseLock()}}
