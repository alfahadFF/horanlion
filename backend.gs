// Google Sheets API for the existing Netlify interface.
// IMPORTANT: Restrict deployment access to authorized club administrators.
const SPREADSHEET_ID = '1DE2Ko35v9iotJw3aSk0NYSjBKmPQv2IwONQs0BYuTN8';
const SHEET_NAMES = ['الاشتراكات','الاشتراكات الخاصة'];
function response_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
function validSheet_(name){if(!SHEET_NAMES.includes(name))throw Error('نوع الاشتراك غير مسموح');const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(name);if(!sh)throw Error('الورقة غير موجودة: '+name);return sh}
function statusColumn_(sh){if(sh.getRange(1,10).getValue()!=='حالة الاشتراك')sh.getRange(1,10).setValue('حالة الاشتراك');return 10}
function date_(v){return v instanceof Date?Utilities.formatDate(v,Session.getScriptTimeZone(),'yyyy-MM-dd'):String(v||'')}
function doGet(e){try{if((e.parameter.action||'list')!=='list')throw Error('عملية غير مدعومة');const records=[];for(const name of SHEET_NAMES){const sh=validSheet_(name),last=sh.getLastRow();if(last<2)continue;sh.getRange(2,1,last-1,10).getValues().forEach((v,i)=>{if(!String(v[0]).trim())return;records.push({sheet:name,row:i+2,name:String(v[0]||''),phone:String(v[1]||''),transport:String(v[2]||''),course:String(v[3]||''),date:date_(v[4]),cost:Number(v[5])||0,pay1:Number(v[6])||0,pay2:Number(v[7])||0,status:String(v[9]||'نشط')})})}return response_({ok:true,records})}catch(err){return response_({ok:false,error:String(err.message)})}}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(20000);const p=JSON.parse(e.postData.contents);if(!['save','toggle','delete'].includes(p.action))throw Error('عملية غير مدعومة');const sh=validSheet_(p.sheet);let row=Number(p.row)||0;if(row&&( !Number.isInteger(row)||row<2||row>sh.getLastRow()))throw Error('رقم الصف غير صحيح');if(p.action==='delete'){if(!row)throw Error('حدد مشتركًا');sh.deleteRow(row);return response_({ok:true})}if(p.action==='toggle'){if(!row)throw Error('حدد مشتركًا');statusColumn_(sh);const old=String(sh.getRange(row,10).getValue());const status=old==='معلّق'?'نشط':'معلّق';sh.getRange(row,10).setValue(status);return response_({ok:true,status})}const name=String(p.name||'').trim();if(!name)throw Error('الاسم مطلوب');const nums=['cost','pay1','pay2'].map(k=>Number(p[k]||0));if(nums.some(n=>!Number.isFinite(n)||n<0))throw Error('مبالغ غير صالحة');statusColumn_(sh);if(!row)row=sh.getLastRow()+1;const [cost,pay1,pay2]=nums;sh.getRange(row,2).setNumberFormat('@');sh.getRange(row,1,1,8).setValues([[name,String(p.phone||''),p.transport==='نعم'?'نعم':'لا',String(p.course||''),String(p.date||''),cost,pay1,pay2]]);sh.getRange(row,9).setFormula('=F'+row+'-G'+row+'-H'+row);if(!sh.getRange(row,10).getValue())sh.getRange(row,10).setValue('نشط');return response_({ok:true,row})}catch(err){return response_({ok:false,error:String(err.message)})}finally{if(lock.hasLock())lock.releaseLock()}}
